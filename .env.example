# --- Core ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Multi-tenant readiness flag: nothing else assumes a single user.
SIGNUPS_ENABLED=false
# Owner account email; the only address allowed to sign up while
# SIGNUPS_ENABLED=false, and the admin for featured-gallery review.
OWNER_EMAIL=owner@example.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Direct Postgres connection (Drizzle + pg-boss). Use the pooled connection
# string for serverless routes and the direct one for migrations/workers.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Storage ---
# Buckets are created by scripts/setup-storage.ts
STORAGE_ORIGINALS_BUCKET=originals
STORAGE_DERIVATIVES_BUCKET=derivatives
STORAGE_EXPORTS_BUCKET=exports

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price IDs created by scripts/setup-stripe.ts
STRIPE_PRICE_CREATION=price_...
STRIPE_PRICE_S_MONTHLY=price_...
STRIPE_PRICE_S_ANNUAL_BUNDLE=price_...
STRIPE_PRICE_L_MONTHLY=price_...
STRIPE_PRICE_L_ANNUAL_BUNDLE=price_...
STRIPE_PRICE_DOWNLOAD=price_...

# --- Resend ---
RESEND_API_KEY=re_...
EMAIL_FROM="Wanderwall <hello@example.com>"

# --- Cloud imports (optional until phase 7) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- Worker ---
# Secret shared with Vercel cron / queue-drain route.
CRON_SECRET=change-me

# --- Dormant feature flags (do not enable; seams only) ---
FEATURE_AI_SKYBOX=false
